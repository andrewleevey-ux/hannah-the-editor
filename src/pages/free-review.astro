---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Free Opening Chapter Review — Hannah The Editor">
	<section class="bg-brand-base py-24 lg:py-32">
		<div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
			<h1 class="font-sans text-3xl font-medium leading-tight text-brand-ink sm:text-4xl lg:text-5xl">
				Free Opening Chapter Review — Coming Soon
			</h1>

			<div class="mt-10">
				<a
					href="/"
					class="inline-flex w-full items-center justify-center rounded-full bg-[#2B3A4A] px-7 py-3.5 text-sm font-semibold text-white shadow-xs transition duration-200 hover:bg-[#1F2B38] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2B3A4A] focus-visible:ring-offset-2 md:w-auto"
				>
					Back to Home
				</a>
			</div>
		</div>
	</section>
</Layout>
