---
import Layout from '../layouts/Layout.astro';
import { siteContent } from '../data/content';
---

<Layout title="Hannah The Editor — Thoughtful Manuscript Editing">
	<!-- 1. Full-Bleed Hero Section with Gradient Scrim & Inline Trust Strip -->
	<section class="relative flex min-h-[600px] items-center overflow-hidden bg-[#FFF5F5] py-20 lg:min-h-[680px] lg:py-28">
		<!-- Full-Bleed Background Image Layer -->
		<img
			src="/images/nong-9pw4TKvT3po-unsplash.jpg"
			alt=""
			aria-hidden="true"
			fetchpriority="high"
			decoding="async"
			class="absolute inset-0 h-full w-full object-cover object-right"
		/>

		<!-- Responsive Contrast Scrim -->
		<div
			aria-hidden="true"
			class="pointer-events-none absolute inset-0 bg-[#FFF5F5]/90 md:bg-transparent md:bg-gradient-to-r md:from-[#FFF5F5] md:via-[#FFF5F5]/90 md:to-transparent"
		></div>

		<!-- Left-Aligned Conversion Stack -->
		<div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="max-w-2xl">
				<p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#4A4A4A]/80">
					{siteContent.hero.eyebrow}
				</p>

				<h1 class="mt-4 font-sans text-[48px] font-medium leading-[1.12] text-[#4A4A4A]">
					{siteContent.hero.headline}
				</h1>

				<div class="mt-6 max-w-xl space-y-4 text-base leading-relaxed text-[#4A4A4A] sm:text-lg">
					{siteContent.hero.paragraphs.map((paragraph) => (
						<p>{paragraph}</p>
					))}
				</div>

				<!-- Inline Trust Strip -->
				<ul class="mt-6 mb-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-[#4A4A4A]">
					{siteContent.hero.conversionBar.highlights.map((highlight) => (
						<li class="flex items-center gap-2 font-medium">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								class="lucide lucide-check h-4 w-4 shrink-0 text-[#4A4A4A]"
							>
								<path d="M20 6 9 17l-5-5"></path>
							</svg>
							<span>{highlight}</span>
						</li>
					))}
				</ul>

				<div>
					<a
						href={siteContent.hero.primaryCta.href}
						class="inline-flex w-full items-center justify-center rounded-full bg-brand-accent px-8 py-4 text-sm font-semibold text-[#4A4A4A] shadow-xs transition duration-200 hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4A4A4A] md:w-auto"
					>
						{siteContent.hero.primaryCta.label}
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. Editing Services (Canvas: brand-base, Cards: brand-surface) -->
	<section id="services" class="scroll-mt-16 border-t border-brand-ink/10 bg-brand-base py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="mx-auto max-w-2xl text-center">
				<h2 class="font-sans text-3xl font-medium text-brand-ink sm:text-4xl lg:text-5xl">
					{siteContent.services.heading}
				</h2>
				<p class="mt-4 text-base leading-relaxed text-brand-ink/75">
					{siteContent.services.intro}
				</p>
			</div>

			<!-- Featured Service Card (Full-Width Prominent Card) -->
			<article
				data-reveal
				class="mt-16 rounded-3xl border-2 border-brand-accent bg-brand-surface p-8 shadow-md sm:p-10"
			>
				<div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
					<div class="max-w-3xl">
						<h3 class="font-sans text-2xl font-semibold text-brand-ink sm:text-3xl">
							{siteContent.services.featured.title}
						</h3>
						<p class="mt-3 text-base leading-relaxed text-brand-ink/80">
							{siteContent.services.featured.description}
						</p>
					</div>

					<div class="shrink-0">
						<a
							href={siteContent.services.featured.cta.href}
							class="inline-flex w-full items-center justify-center rounded-full bg-brand-accent px-7 py-3.5 text-sm font-semibold text-brand-ink shadow-xs transition duration-200 hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-ink md:w-auto"
						>
							{siteContent.services.featured.cta.label}
						</a>
					</div>
				</div>
			</article>

			<!-- Core Services (3-Column Feature Grid) -->
			<div class="mt-10 grid grid-cols-1 items-stretch gap-8 md:grid-cols-3 lg:gap-10">
				{siteContent.services.core.map((service, index) => (
					<article
						data-reveal
						style={`--reveal-delay: ${index * 90}ms`}
						class="flex flex-col rounded-3xl border border-brand-ink/10 bg-brand-surface p-7 transition duration-300 hover:border-brand-ink/25 sm:p-8"
					>
						<div class="rounded-2xl bg-brand-base p-5">
							<div
								role="img"
								aria-label="Image Placeholder"
								class="flex aspect-[4/3] w-full items-center justify-center rounded-xl bg-neutral-200 text-sm font-medium text-neutral-500"
							>
								Image Placeholder
							</div>
						</div>

						<h3 class="mt-7 font-sans text-2xl font-medium text-brand-ink">
							{service.title}
						</h3>
						<p class="mt-3 flex-1 text-sm leading-relaxed text-brand-ink/75">
							{service.description}
						</p>
					</article>
				))}
			</div>

			<!-- Editing Packages (Centered 2-Column Row) -->
			<div class="mx-auto mt-10 grid max-w-4xl grid-cols-1 gap-8 md:grid-cols-2">
				{siteContent.services.packages.map((pkg, index) => (
					<article
						data-reveal
						style={`--reveal-delay: ${index * 90}ms`}
						class="flex flex-col rounded-3xl border border-brand-accent/60 bg-brand-surface p-7 shadow-xs transition duration-300 hover:border-brand-accent sm:p-8"
					>
						<h3 class="font-sans text-2xl font-medium text-brand-ink">
							{pkg.title}
						</h3>
						<p class="mt-3 flex-1 text-sm leading-relaxed text-brand-ink/80">
							{pkg.description}
						</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- 3. How My Editing Process Works (Alternating Panel: brand-surface) -->
	<section id="process" class="scroll-mt-16 border-y border-brand-ink/10 bg-brand-surface py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="mx-auto max-w-3xl text-center">
				<h2 class="font-sans text-3xl font-medium leading-tight text-brand-ink sm:text-4xl lg:text-5xl">
					{siteContent.process.heading}
				</h2>
			</div>

			<ol class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
				{siteContent.process.steps.map((step, index) => (
					<li
						data-reveal
						style={`--reveal-delay: ${index * 80}ms`}
						class="flex flex-col rounded-3xl border border-brand-ink/10 bg-brand-base p-7 sm:p-8"
					>
						<span class="font-sans text-4xl font-semibold tracking-tight text-brand-accent sm:text-5xl">
							{step.number}
						</span>
						<h3 class="mt-4 font-sans text-xl font-medium text-brand-ink">
							{step.title}
						</h3>
						<p class="mt-3 flex-1 text-sm leading-relaxed text-brand-ink/75">
							{step.description}
						</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- 4. What It’s Like to Work With Me (Canvas: brand-base) -->
	<section id="features" class="scroll-mt-16 bg-brand-base py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="mx-auto max-w-2xl text-center">
				<h2 class="font-sans text-3xl font-medium text-brand-ink sm:text-4xl lg:text-5xl">
					{siteContent.workingWithMe.heading}
				</h2>
				<p class="mt-4 text-base leading-relaxed text-brand-ink/75">
					{siteContent.workingWithMe.intro}
				</p>
			</div>

			<div class="mt-16 grid grid-cols-1 items-center gap-12 md:grid-cols-3 lg:gap-14">
				<!-- Left Column: Two Stacked Text Blocks -->
				<div data-reveal class="space-y-12 md:text-right">
					{siteContent.workingWithMe.pillars.slice(0, 2).map((pillar) => (
						<div class="rounded-2xl bg-brand-surface/75 p-6">
							<h3 class="font-sans text-2xl font-medium text-brand-ink">
								{pillar.title}
							</h3>
							<p class="mt-3 text-sm leading-relaxed text-brand-ink/75">
								{pillar.description}
							</p>
						</div>
					))}
				</div>

				<!-- Center Column: Large, Tall Vertical Image Placeholder -->
				<div data-reveal style="--reveal-delay: 80ms" class="mx-auto w-full max-w-sm">
					<div
						role="img"
						aria-label="Image Placeholder"
						class="flex aspect-[3/4.3] min-h-[420px] w-full items-center justify-center rounded-3xl bg-neutral-200 text-sm font-medium tracking-wide text-neutral-500 shadow-xs"
					>
						Image Placeholder
					</div>
				</div>

				<!-- Right Column: Two Stacked Text Blocks Matching Left -->
				<div data-reveal style="--reveal-delay: 160ms" class="space-y-12">
					{siteContent.workingWithMe.pillars.slice(2, 4).map((pillar) => (
						<div class="rounded-2xl bg-brand-surface/75 p-6">
							<h3 class="font-sans text-2xl font-medium text-brand-ink">
								{pillar.title}
							</h3>
							<p class="mt-3 text-sm leading-relaxed text-brand-ink/75">
								{pillar.description}
							</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 5. More for Authors, Coming Soon (Alternating Panel: brand-surface) -->
	<section id="highlights" class="scroll-mt-16 border-y border-brand-ink/10 bg-brand-surface py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="mx-auto max-w-2xl text-center">
				<h2 class="font-sans text-3xl font-medium text-brand-ink sm:text-4xl lg:text-5xl">
					{siteContent.comingSoon.heading}
				</h2>
				<p class="mt-4 text-base leading-relaxed text-brand-ink/75">
					{siteContent.comingSoon.intro}
				</p>
			</div>

			<div class="mt-20 space-y-28 lg:space-y-36">
				{siteContent.comingSoon.items.map((item, index) => {
					const isReversed = index % 2 === 1;
					return (
						<div data-reveal class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 lg:gap-20">
							<div
								class={
									isReversed
										? 'relative order-1 pr-6 pb-6 md:order-2'
										: 'relative pb-6 pl-6'
								}
							>
								<div
									aria-hidden="true"
									class={
										isReversed
											? 'absolute right-0 bottom-0 h-[88%] w-[88%] rounded-3xl bg-brand-accent/15'
											: 'absolute bottom-0 left-0 h-[88%] w-[88%] rounded-3xl bg-brand-base'
									}
								></div>
								<div
									role="img"
									aria-label="Image Placeholder"
									class="relative z-10 flex aspect-[4/3] w-full items-center justify-center rounded-2xl bg-neutral-200 text-sm font-medium text-neutral-500 shadow-xs"
								>
									Image Placeholder
								</div>
							</div>

							<div class={isReversed ? 'order-2 md:order-1' : ''}>
								<h3 class="font-sans text-3xl font-medium text-brand-ink sm:text-4xl">
									{item.title}
								</h3>
								<p class="mt-4 text-base leading-relaxed text-brand-ink/80">
									{item.description}
								</p>
								<div class="mt-8">
									<a
										href={item.ctaHref}
										class="inline-flex w-full items-center justify-center rounded-full bg-brand-accent px-7 py-3.5 text-sm font-semibold text-brand-ink shadow-xs transition duration-200 hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-ink md:w-auto"
									>
										{item.ctaLabel}
									</a>
								</div>
							</div>
						</div>
					);
				})}
			</div>
		</div>
	</section>

	<!-- 5. Reviews & Lead Capture (Canvas: brand-base, Form Container: brand-surface) -->
	<section id="reviews" class="scroll-mt-16 bg-brand-base py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<!-- Reviews Carousel with Left/Right Navigation Arrows -->
			<div data-reveal class="mx-auto max-w-4xl text-center">
				<h2 class="font-sans text-3xl font-medium text-brand-ink sm:text-4xl lg:text-5xl">
					Kind Words From Authors
				</h2>

				<div class="mt-12 flex items-center justify-between gap-4 sm:gap-8">
					<button
						id="review-prev"
						type="button"
						aria-label="Previous testimonial"
						class="flex h-12 w-12 shrink-0 cursor-pointer items-center justify-center rounded-full border border-brand-ink/20 bg-brand-surface text-brand-ink transition hover:border-brand-accent hover:bg-brand-accent hover:text-brand-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
					>
						<span aria-hidden="true" class="text-lg">&larr;</span>
					</button>

					<div class="min-h-[11rem] flex-1 px-2">
						<figure data-testimonial class="space-y-6">
							<blockquote class="font-sans text-2xl italic leading-relaxed text-brand-ink sm:text-3xl">
								&ldquo;Her free opening chapter review alone taught me more about scene tension than two
								years of workshops. Working with Hannah turned a sprawling third draft into a debut
								novel acquired at auction.&rdquo;
							</blockquote>
							<figcaption class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-ink/75">
								Julian Mercer &mdash; Literary Fiction Author
							</figcaption>
						</figure>

						<figure data-testimonial hidden class="space-y-6">
							<blockquote class="font-sans text-2xl italic leading-relaxed text-brand-ink sm:text-3xl">
								&ldquo;Rarely do you find an editor who combines razor-sharp structural instinct with
								such warmth and reverence for an author&rsquo;s voice. Every margin note made my book
								braver and clearer.&rdquo;
							</blockquote>
							<figcaption class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-ink/75">
								Nadia Okafor &mdash; Memoirist &amp; Essayist
							</figcaption>
						</figure>

						<figure data-testimonial hidden class="space-y-6">
							<blockquote class="font-sans text-2xl italic leading-relaxed text-brand-ink sm:text-3xl">
								&ldquo;Hannah pinpointed why my opening chapter stalled within three paragraphs. Two
								weeks after revising with her notes, I received four full manuscript requests from top
								agents.&rdquo;
							</blockquote>
							<figcaption class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-ink/75">
								Clara Vance &mdash; Historical Novel Debut
							</figcaption>
						</figure>
					</div>

					<button
						id="review-next"
						type="button"
						aria-label="Next testimonial"
						class="flex h-12 w-12 shrink-0 cursor-pointer items-center justify-center rounded-full border border-brand-ink/20 bg-brand-surface text-brand-ink transition hover:border-brand-accent hover:bg-brand-accent hover:text-brand-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
					>
						<span aria-hidden="true" class="text-lg">&rarr;</span>
					</button>
				</div>
			</div>

			<!-- Form Container: Wide Rounded-Corner Block (Background: brand-surface, zero harsh white) -->
			<div
				id="free-chapter-review"
				data-reveal
				class="mt-24 scroll-mt-24 rounded-3xl border border-brand-ink/12 bg-brand-surface px-6 py-12 sm:px-12 sm:py-16 lg:px-16"
			>
				<div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
					<!-- Left: Text -->
					<div class="lg:col-span-6">
						<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-ink/70">
							Complimentary 1,500-Word Sample Edit
						</p>
						<h3 class="mt-2 font-sans text-3xl font-medium text-brand-ink sm:text-4xl">
							Book a free opening chapter review.
						</h3>
						<p class="mt-3 text-sm leading-relaxed text-brand-ink/80 sm:text-base">
							Enter your email below and Hannah will send a private upload link for your opening pages,
							returning tracked edits and a 1-page diagnostic memo within 48 hours.
						</p>
					</div>

					<!-- Right: Lead-Capture Input Field + Submit Button -->
					<div class="lg:col-span-6">
						<form id="lead-capture-form" class="flex flex-col gap-3 md:flex-row">
							<label for="lead-email" class="sr-only">Email address</label>
							<input
								id="lead-email"
								name="email"
								type="email"
								required
								autocomplete="email"
								placeholder="Enter your email address..."
								class="min-w-0 flex-1 rounded-full border border-brand-ink/20 bg-brand-base px-6 py-4 text-sm text-brand-ink placeholder:text-brand-ink/45 focus:border-brand-accent focus:outline-none"
							/>
							<button
								type="submit"
								class="inline-flex w-full shrink-0 cursor-pointer items-center justify-center rounded-full bg-brand-accent px-8 py-4 text-sm font-semibold text-brand-ink shadow-xs transition duration-200 hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent md:w-auto"
							>
								Get Free Review
							</button>
						</form>

						<p
							id="lead-capture-confirmation"
							hidden
							role="status"
							aria-live="polite"
							class="rounded-2xl border border-brand-accent/30 bg-brand-base px-6 py-4 text-sm font-medium text-brand-ink"
						>
							Thank you! Check your inbox shortly for your private Chapter One upload link.
						</p>

						<p class="mt-3 text-xs text-brand-ink/65 sm:pl-2">
							Zero obligation &middot; 100% author confidentiality guaranteed.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script is:inline>
	(() => {
		// Testimonial Carousel Navigation
		const slides = Array.from(document.querySelectorAll('[data-testimonial]'));
		const prevBtn = document.getElementById('review-prev');
		const nextBtn = document.getElementById('review-next');
		let activeIndex = 0;

		function showSlide(index) {
			slides.forEach((slide, i) => {
				if (i === index) {
					slide.removeAttribute('hidden');
				} else {
					slide.setAttribute('hidden', '');
				}
			});
		}

		if (slides.length && prevBtn && nextBtn) {
			prevBtn.addEventListener('click', () => {
				activeIndex = (activeIndex - 1 + slides.length) % slides.length;
				showSlide(activeIndex);
			});

			nextBtn.addEventListener('click', () => {
				activeIndex = (activeIndex + 1) % slides.length;
				showSlide(activeIndex);
			});
		}

		// Lead Capture Form Confirmation
		const form = document.getElementById('lead-capture-form');
		const confirmation = document.getElementById('lead-capture-confirmation');
		if (form && confirmation) {
			form.addEventListener('submit', (event) => {
				event.preventDefault();
				form.setAttribute('hidden', '');
				confirmation.removeAttribute('hidden');
			});
		}
	})();
</script>
