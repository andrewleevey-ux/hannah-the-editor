---
import Layout from '../layouts/Layout.astro';
import { siteContent } from '../data/content';
---

<Layout title="Hannah The Editor — Thoughtful Manuscript Editing">
	<!-- 1. Full-Bleed Hero Section with Gradient Scrim & Inline Trust Strip -->
	<section class="relative flex min-h-[600px] items-center overflow-hidden bg-[#FFF5F5] pt-20 pb-12 lg:min-h-[680px] lg:pt-28 lg:pb-16">
		<!-- Full-Bleed Background Image Layer -->
		<img
			src="/images/nong-9pw4TKvT3po-unsplash.jpg"
			alt=""
			aria-hidden="true"
			fetchpriority="high"
			decoding="async"
			class="absolute inset-0 h-full w-full object-cover object-right"
		/>

		<!-- Responsive Contrast Scrim -->
		<div
			aria-hidden="true"
			class="pointer-events-none absolute inset-0 bg-[#FFF5F5]/90 md:bg-transparent md:bg-gradient-to-r md:from-[#FFF5F5] md:via-[#FFF5F5]/90 md:to-transparent"
		></div>

		<!-- Left-Aligned Conversion Stack -->
		<div class="relative z-10 mx-auto w-full max-w-7xl px-4 pb-24 sm:px-6 md:pb-32 lg:px-8">
			<div class="max-w-2xl">
				<p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#4A4A4A]/80">
					{siteContent.hero.eyebrow}
				</p>

				<h1 class="mt-4 font-sans text-[48px] font-medium leading-[1.12] text-[#4A4A4A]">
					{siteContent.hero.headline}
				</h1>

				<div class="mt-6 max-w-xl space-y-4 text-base leading-relaxed text-[#4A4A4A] sm:text-lg">
					{siteContent.hero.paragraphs.map((paragraph) => (
						<p>{paragraph}</p>
					))}
				</div>

				<!-- Inline Trust Strip -->
				<ul class="mt-6 mb-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-[#4A4A4A]">
					{siteContent.hero.conversionBar.highlights.map((highlight) => (
						<li class="flex items-center gap-2 font-medium">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								class="lucide lucide-check h-4 w-4 shrink-0 text-[#4A4A4A]"
							>
								<path d="M20 6 9 17l-5-5"></path>
							</svg>
							<span>{highlight}</span>
						</li>
					))}
				</ul>

				<div>
					<a
						href={siteContent.hero.primaryCta.href}
						class="inline-flex w-full items-center justify-center rounded-full bg-[#2B3A4A] px-8 py-4 text-sm font-semibold text-white shadow-xs transition duration-200 hover:bg-[#1F2B38] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2B3A4A] focus-visible:ring-offset-2 md:w-auto"
					>
						{siteContent.hero.primaryCta.label}
					</a>
				</div>
			</div>
		</div>

		<!-- Organic Bottom Wave Divider -->
		<div
			aria-hidden="true"
			class="pointer-events-none absolute bottom-0 left-0 right-0 z-20 -mb-px w-full overflow-hidden leading-none"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 1440 120"
				preserveAspectRatio="none"
				focusable="false"
				class="relative block h-[48px] w-full md:h-[80px] lg:h-[100px]"
			>
				<path
					d="M0,40 C320,120 680,0 1080,70 C1260,100 1380,80 1440,55 L1440,120 L0,120 Z"
					class="fill-[#FFFFFF]"
				></path>
			</svg>
		</div>
	</section>

	<!-- 2. Editing Services (Background: bg-white, Cards: bg-brand-surface #FCE8EC) -->
	<section id="services" class="scroll-mt-16 bg-white py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="mx-auto max-w-2xl text-center">
				<h2 class="font-sans text-3xl font-medium text-brand-ink sm:text-4xl lg:text-5xl">
					{siteContent.services.heading}
				</h2>
				<p class="mt-4 text-base leading-relaxed text-brand-ink/75">
					{siteContent.services.intro}
				</p>
			</div>

			<!-- Featured Service Card (Full-Width Prominent Card) -->
			<article
				data-reveal
				class="mt-16 rounded-3xl border-2 border-brand-accent bg-brand-surface p-8 shadow-md sm:p-10"
			>
				<div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
					<div class="max-w-3xl">
						<h3 class="font-sans text-2xl font-semibold text-brand-ink sm:text-3xl">
							{siteContent.services.featured.title}
						</h3>
						<p class="mt-3 text-base leading-relaxed text-brand-ink/80">
							{siteContent.services.featured.description}
						</p>
					</div>

					<div class="shrink-0">
						<a
							href={siteContent.services.featured.cta.href}
							class="inline-flex w-full items-center justify-center rounded-full bg-[#2B3A4A] px-7 py-3.5 text-sm font-semibold text-white shadow-xs transition duration-200 hover:bg-[#1F2B38] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2B3A4A] focus-visible:ring-offset-2 md:w-auto"
						>
							{siteContent.services.featured.cta.label}
						</a>
					</div>
				</div>
			</article>

			<!-- Core Services (3-Column Feature Grid) -->
			<div class="mt-10 grid grid-cols-1 items-stretch gap-8 md:grid-cols-3 lg:gap-10">
				{siteContent.services.core.map((service, index) => (
					<article
						data-reveal
						style={`--reveal-delay: ${index * 90}ms`}
						class="flex flex-col rounded-3xl border border-brand-ink/10 bg-brand-surface p-7 transition duration-300 hover:border-brand-ink/25 sm:p-8"
					>
						<div class="rounded-2xl bg-brand-base p-5">
							<div
								role="img"
								aria-label="Image Placeholder"
								class="flex aspect-[4/3] w-full items-center justify-center rounded-xl bg-neutral-200 text-sm font-medium text-neutral-500"
							>
								Image Placeholder
							</div>
						</div>

						<h3 class="mt-7 font-sans text-2xl font-medium text-brand-ink">
							{service.title}
						</h3>
						<p class="mt-3 flex-1 text-sm leading-relaxed text-brand-ink/75">
							{service.description}
						</p>
					</article>
				))}
			</div>

			<!-- Editing Packages (Centered 2-Column Row) -->
			<div class="mx-auto mt-10 grid max-w-4xl grid-cols-1 gap-8 md:grid-cols-2">
				{siteContent.services.packages.map((pkg, index) => (
					<article
						data-reveal
						style={`--reveal-delay: ${index * 90}ms`}
						class="flex flex-col rounded-3xl border border-brand-accent/60 bg-brand-surface p-7 shadow-xs transition duration-300 hover:border-brand-accent sm:p-8"
					>
						<h3 class="font-sans text-2xl font-medium text-brand-ink">
							{pkg.title}
						</h3>
						<p class="mt-3 flex-1 text-sm leading-relaxed text-brand-ink/80">
							{pkg.description}
						</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- 3. How My Editing Process Works (Background: bg-[#FCE8EC]) -->
	<section id="process" class="scroll-mt-16 border-y border-[#4A4A4A]/10 bg-[#FCE8EC] py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="mx-auto max-w-3xl text-center">
				<h2 class="font-sans text-3xl font-medium leading-tight text-brand-ink sm:text-4xl lg:text-5xl">
					{siteContent.process.heading}
				</h2>
			</div>

			<ol class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
				{siteContent.process.steps.map((step, index) => (
					<li
						data-reveal
						style={`--reveal-delay: ${index * 80}ms`}
						class="flex flex-col rounded-3xl border border-[#4A4A4A]/10 bg-[#FFF5F5] p-7 sm:p-8"
					>
						<span class="font-sans text-4xl font-semibold tracking-tight text-brand-accent sm:text-5xl">
							{step.number}
						</span>
						<h3 class="mt-4 font-sans text-xl font-medium text-brand-ink">
							{step.title}
						</h3>
						<p class="mt-3 flex-1 text-sm leading-relaxed text-brand-ink/75">
							{step.description}
						</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- 4. What It’s Like to Work With Me (Background: bg-[#FFF5F5]) -->
	<section id="features" class="scroll-mt-16 bg-[#FFF5F5] py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="mx-auto max-w-2xl text-center">
				<h2 class="font-sans text-3xl font-medium text-brand-ink sm:text-4xl lg:text-5xl">
					{siteContent.workingWithMe.heading}
				</h2>
				<p class="mt-4 text-base leading-relaxed text-brand-ink/75">
					{siteContent.workingWithMe.intro}
				</p>
			</div>

			<div class="mt-16 grid grid-cols-1 items-center gap-12 md:grid-cols-3 lg:gap-14">
				<!-- Left Column: Two Stacked Text Blocks -->
				<div data-reveal class="space-y-12 md:text-right">
					{siteContent.workingWithMe.pillars.slice(0, 2).map((pillar) => (
						<div class="rounded-2xl border border-[#4A4A4A]/10 bg-white p-6">
							<h3 class="font-sans text-2xl font-medium text-brand-ink">
								{pillar.title}
							</h3>
							<p class="mt-3 text-sm leading-relaxed text-brand-ink/75">
								{pillar.description}
							</p>
						</div>
					))}
				</div>

				<!-- Center Column: Large, Tall Vertical Image Placeholder -->
				<div data-reveal style="--reveal-delay: 80ms" class="mx-auto w-full max-w-sm">
					<div
						role="img"
						aria-label="Image Placeholder"
						class="flex aspect-[3/4.3] min-h-[420px] w-full items-center justify-center rounded-3xl bg-neutral-200 text-sm font-medium tracking-wide text-neutral-500 shadow-xs"
					>
						Image Placeholder
					</div>
				</div>

				<!-- Right Column: Two Stacked Text Blocks Matching Left -->
				<div data-reveal style="--reveal-delay: 160ms" class="space-y-12">
					{siteContent.workingWithMe.pillars.slice(2, 4).map((pillar) => (
						<div class="rounded-2xl border border-[#4A4A4A]/10 bg-white p-6">
							<h3 class="font-sans text-2xl font-medium text-brand-ink">
								{pillar.title}
							</h3>
							<p class="mt-3 text-sm leading-relaxed text-brand-ink/75">
								{pillar.description}
							</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 5. More for Authors, Coming Soon (Background: bg-white) -->
	<section id="highlights" class="scroll-mt-16 border-y border-[#4A4A4A]/10 bg-white py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="mx-auto max-w-2xl text-center">
				<h2 class="font-sans text-3xl font-medium text-brand-ink sm:text-4xl lg:text-5xl">
					{siteContent.comingSoon.heading}
				</h2>
				<p class="mt-4 text-base leading-relaxed text-brand-ink/75">
					{siteContent.comingSoon.intro}
				</p>
			</div>

			<div class="mt-20 space-y-28 lg:space-y-36">
				{siteContent.comingSoon.items.map((item, index) => {
					const isReversed = index % 2 === 1;
					return (
						<div data-reveal class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 lg:gap-20">
							<div
								class={
									isReversed
										? 'relative order-1 pr-6 pb-6 md:order-2'
										: 'relative pb-6 pl-6'
								}
							>
								<div
									aria-hidden="true"
									class={
										isReversed
											? 'absolute right-0 bottom-0 h-[88%] w-[88%] rounded-3xl bg-[#FCE8EC]/70'
											: 'absolute bottom-0 left-0 h-[88%] w-[88%] rounded-3xl bg-[#FFF5F5]'
									}
								></div>
								<div
									role="img"
									aria-label="Image Placeholder"
									class="relative z-10 flex aspect-[4/3] w-full items-center justify-center rounded-2xl bg-neutral-200 text-sm font-medium text-neutral-500 shadow-xs"
								>
									Image Placeholder
								</div>
							</div>

							<div class={isReversed ? 'order-2 md:order-1' : ''}>
								<h3 class="font-sans text-3xl font-medium text-brand-ink sm:text-4xl">
									{item.title}
								</h3>
								<p class="mt-4 text-base leading-relaxed text-brand-ink/80">
									{item.description}
								</p>
								<div class="mt-8">
									<a
										href={item.ctaHref}
										class="inline-flex w-full items-center justify-center rounded-full bg-[#2B3A4A] px-7 py-3.5 text-sm font-semibold text-white shadow-xs transition duration-200 hover:bg-[#1F2B38] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2B3A4A] focus-visible:ring-offset-2 md:w-auto"
									>
										{item.ctaLabel}
									</a>
								</div>
							</div>
						</div>
					);
				})}
			</div>
		</div>
	</section>

	<!-- 6. Testimonials Carousel (Background: bg-[#FCE8EC]) -->
	<section
		id="reviews"
		aria-roledescription="carousel"
		aria-labelledby="testimonials-heading"
		class="scroll-mt-16 bg-[#FCE8EC] py-24 lg:py-32"
	>
		<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="text-center">
				<h2
					id="testimonials-heading"
					class="font-sans text-3xl font-medium text-[#4A4A4A] sm:text-4xl lg:text-5xl"
				>
					{siteContent.testimonials.heading}
				</h2>
			</div>

			<div data-reveal class="relative mt-12">
				<!-- Left/Right Arrow Controls (Before Track in DOM Order) -->
				<div
					class="mb-6 flex items-center justify-center gap-4 sm:pointer-events-none sm:absolute sm:inset-x-0 sm:top-1/2 sm:z-10 sm:mb-0 sm:-translate-y-1/2 sm:justify-between"
				>
					<button
						id="review-prev"
						type="button"
						aria-label="Previous testimonial"
						class="pointer-events-auto flex h-12 w-12 shrink-0 cursor-pointer touch-manipulation items-center justify-center rounded-full border border-[#4A4A4A]/25 bg-[#FFF5F5] text-[#4A4A4A] shadow-xs transition hover:border-[#4A4A4A]/40 hover:bg-[#E2B4BD] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4A4A4A]"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="22"
							height="22"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							class="lucide lucide-chevron-left h-5 w-5"
						>
							<path d="m15 18-6-6 6-6"></path>
						</svg>
					</button>

					<button
						id="review-next"
						type="button"
						aria-label="Next testimonial"
						class="pointer-events-auto flex h-12 w-12 shrink-0 cursor-pointer touch-manipulation items-center justify-center rounded-full border border-[#4A4A4A]/25 bg-[#FFF5F5] text-[#4A4A4A] shadow-xs transition hover:border-[#4A4A4A]/40 hover:bg-[#E2B4BD] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4A4A4A]"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="22"
							height="22"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							class="lucide lucide-chevron-right h-5 w-5"
						>
							<path d="m9 18 6-6-6-6"></path>
						</svg>
					</button>
				</div>

				<!-- Horizontally Scroll-Snapped Track (Balances Height Automatically Across All Quotes) -->
				<div
					id="testimonial-track"
					tabindex="0"
					role="group"
					aria-label="Author testimonials"
					class="testimonial-track relative rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4A4A4A]"
				>
					{siteContent.testimonials.quotes.map((quote, index) => (
						<figure
							role="group"
							aria-roledescription="slide"
							aria-label={`${index + 1} of ${siteContent.testimonials.quotes.length}`}
							data-testimonial-slide
							data-slide-index={index}
							class="flex items-center justify-center px-2 py-2 text-center sm:px-20"
						>
							<blockquote class="mx-auto max-w-3xl font-sans text-lg italic leading-relaxed text-[#4A4A4A] sm:text-xl md:text-2xl">
								&ldquo;{quote}&rdquo;
							</blockquote>
						</figure>
					))}
				</div>

				<!-- Visually Hidden Polite Status Region for Screen Readers -->
				<p id="testimonial-status" class="sr-only" role="status" aria-live="polite"></p>
			</div>

			<!-- Slide Indicator Dots & Subtle Counter -->
			<div data-reveal class="mt-8 flex flex-col items-center gap-3">
				<nav
					id="testimonial-markers"
					aria-label="Choose a testimonial"
					class="flex flex-wrap items-center justify-center gap-1"
				>
					{siteContent.testimonials.quotes.map((_, index) => (
						<button
							type="button"
							data-testimonial-dot={index}
							aria-label={`Go to testimonial ${index + 1}`}
							aria-current={index === 0 ? 'true' : undefined}
							class="group flex h-6 w-6 cursor-pointer touch-manipulation items-center justify-center rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4A4A4A]"
						>
							<span
								aria-hidden="true"
								class="block h-2 w-2 rounded-full bg-[#4A4A4A]/40 transition-all duration-200 group-hover:bg-[#4A4A4A]/70 group-aria-[current=true]:w-5 group-aria-[current=true]:bg-[#4A4A4A]"
							></span>
						</button>
					))}
				</nav>

				<p
					id="testimonial-counter"
					aria-hidden="true"
					class="text-xs font-semibold tracking-[0.18em] text-[#4A4A4A]/80"
				>
					1 / {siteContent.testimonials.quotes.length}
				</p>
			</div>
		</div>
	</section>

	<!-- 7. Frequently Asked Questions Accordion (Background: bg-[#FFF5F5]) -->
	<section
		id="faqs"
		aria-labelledby="faqs-heading"
		class="scroll-mt-16 border-t border-[#4A4A4A]/10 bg-[#FFF5F5] py-24 lg:py-32"
	>
		<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="text-center">
				<h2
					id="faqs-heading"
					class="font-sans text-3xl font-medium text-[#4A4A4A] sm:text-4xl lg:text-5xl"
				>
					{siteContent.faqs.heading}
				</h2>
			</div>

			<div data-reveal class="mt-14 divide-y divide-[#4A4A4A]/20 border-y border-[#4A4A4A]/20">
				{siteContent.faqs.items.map((item) => (
					<details class="faq-item group">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-6 text-left font-sans text-lg font-medium text-[#4A4A4A] transition-colors hover:text-[#4A4A4A]/75 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4A4A4A] sm:text-xl">
							<span>{item.question}</span>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="20"
								height="20"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								class="lucide lucide-chevron-down h-5 w-5 shrink-0 text-[#4A4A4A]/75 motion-safe:transition-transform motion-safe:duration-200 group-open:rotate-180"
							>
								<path d="m6 9 6 6 6-6"></path>
							</svg>
						</summary>
						<div class="space-y-4 pb-6 pr-8 text-base leading-relaxed text-[#4A4A4A]/85">
							{item.answers.map((paragraph) => (
								<p>{paragraph}</p>
							))}
						</div>
					</details>
				))}
			</div>

			<!-- Final CTA Directly Below Accordion -->
			<div data-reveal class="mt-12 text-center">
				<a
					href={siteContent.faqs.cta.href}
					class="inline-flex w-full items-center justify-center rounded-full bg-[#2B3A4A] px-8 py-4 text-sm font-semibold text-white shadow-xs transition duration-200 hover:bg-[#1F2B38] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2B3A4A] focus-visible:ring-offset-2 md:w-auto"
				>
					{siteContent.faqs.cta.label}
				</a>
			</div>
		</div>
	</section>

	<!-- 8. Waitlist Bar (Background: bg-white, Inner Bar: bg-[#FFF5F5]) -->
	<section
		id={siteContent.waitlist.id}
		aria-labelledby="waitlist-heading"
		class="scroll-mt-24 border-t border-[#4A4A4A]/10 bg-white py-20 lg:py-24"
	>
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div
				data-reveal
				class="rounded-3xl border border-[#4A4A4A]/15 bg-[#FFF5F5] px-6 py-12 sm:px-12 sm:py-16 lg:px-16"
			>
				<div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
					<!-- Left: Heading & Description -->
					<div class="lg:col-span-6">
						<h2
							id="waitlist-heading"
							class="font-sans text-3xl font-medium text-[#4A4A4A] sm:text-4xl"
						>
							{siteContent.waitlist.heading}
						</h2>
						<p class="mt-3 text-base leading-relaxed text-[#4A4A4A]/80">
							{siteContent.waitlist.description}
						</p>
					</div>

					<!-- Right: Email Input + Submit Button -->
					<div class="lg:col-span-6">
						<form
							id="waitlist-form"
							aria-labelledby="waitlist-heading"
							class="flex flex-col gap-3 md:flex-row"
						>
							<label for="waitlist-email" class="sr-only">Email address</label>
							<input
								id="waitlist-email"
								name="email"
								type="email"
								required
								autocomplete="email"
								autocorrect="off"
								autocapitalize="none"
								spellcheck="false"
								enterkeyhint="done"
								placeholder={siteContent.waitlist.placeholder}
								class="waitlist-input min-h-12 min-w-0 flex-1 rounded-full border border-[#4A4A4A]/35 bg-white px-6 py-3.5 text-base text-[#4A4A4A] placeholder:text-[#4A4A4A]/55 focus-visible:border-[#4A4A4A] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4A4A4A]"
							/>
							<button
								id="waitlist-submit"
								type="submit"
								class="inline-flex min-h-12 w-full shrink-0 cursor-pointer items-center justify-center rounded-full bg-[#2B3A4A] px-8 py-3.5 text-sm font-semibold text-white shadow-xs transition duration-200 hover:bg-[#1F2B38] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2B3A4A] focus-visible:ring-offset-2 md:w-auto"
							>
								{siteContent.waitlist.buttonLabel}
							</button>
						</form>

						<p
							id="waitlist-confirmation"
							hidden
							role="status"
							aria-live="polite"
							class="rounded-2xl border border-[#E2B4BD] bg-white px-6 py-4 text-sm font-medium text-[#4A4A4A]"
						>
							Thanks! You're on the early-access list.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script is:inline>
	(() => {
		// Testimonials Carousel: native scroll-snap + CSS order looping + live & settled state sync
		const track = document.getElementById('testimonial-track');
		const prevBtn = document.getElementById('review-prev');
		const nextBtn = document.getElementById('review-next');
		const statusEl = document.getElementById('testimonial-status');
		const counterEl = document.getElementById('testimonial-counter');
		const slides = track ? Array.from(track.querySelectorAll('[data-testimonial-slide]')) : [];
		const dots = Array.from(document.querySelectorAll('[data-testimonial-dot]'));

		if (track && slides.length >= 3 && prevBtn && nextBtn) {
			const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
			const prefersReducedMotion = () => reducedMotionQuery.matches;

			if (!CSS.supports('order: sibling-count()')) {
				track.style.setProperty('--children-count', String(slides.length));
			}

			let activeIndicatorIndex = 0;
			let lastSettledIndex = 0;
			let pendingTargetSlide = null;
			let pendingStartScrollLeft = null;
			let isInDomOrderForMarkerTrip = false;
			let queuedDirection = 0;
			let scrollRafId = 0;
			let scrollFallbackTimer = 0;
			let instantSettleRafId = 0;

			function getVisualSlides() {
				return [...slides].sort((a, b) => a.offsetLeft - b.offsetLeft);
			}

			function getNearestSlide() {
				const trackCenter = track.scrollLeft + track.clientWidth / 2;
				let nearest = slides[0];
				let minDistance = Infinity;
				for (const slide of slides) {
					const slideCenter = slide.offsetLeft + slide.offsetWidth / 2;
					const distance = Math.abs(slideCenter - trackCenter);
					if (distance < minDistance) {
						minDistance = distance;
						nearest = slide;
					}
				}
				return nearest;
			}

			function updateIndicators(index) {
				if (index === activeIndicatorIndex && dots[index]?.getAttribute('aria-current') === 'true') {
					return;
				}
				activeIndicatorIndex = index;
				dots.forEach((dot, i) => {
					if (i === index) {
						dot.setAttribute('aria-current', 'true');
					} else {
						dot.removeAttribute('aria-current');
					}
				});
				if (counterEl) {
					counterEl.textContent = `${index + 1} / ${slides.length}`;
				}
			}

			function repositionWithCompensation(updateOrderFn, lockOverflow) {
				const anchor = getNearestSlide();
				const beforeOffset = anchor.offsetLeft;
				track.style.scrollSnapType = 'none';
				if (lockOverflow) {
					track.style.overflowX = 'hidden';
				}
				updateOrderFn();
				const diff = anchor.offsetLeft - beforeOffset;
				if (diff !== 0) {
					track.scrollBy({ left: diff, behavior: 'instant' });
				}
				track.style.scrollSnapType = '';
				if (lockOverflow) {
					requestAnimationFrame(() => {
						requestAnimationFrame(() => {
							track.style.overflowX = '';
						});
					});
				}
			}

			function scrollToSlide(targetSlide) {
				if (track.style.overflowX === 'hidden') {
					track.style.overflowX = '';
				}
				const targetCenter = targetSlide.offsetLeft + targetSlide.offsetWidth / 2;
				const currentCenter = track.scrollLeft + track.clientWidth / 2;
				const delta = targetCenter - currentCenter;
				const useInstant = prefersReducedMotion();

				if (Math.abs(delta) < 1) {
					handleSettle();
					return;
				}

				track.scrollBy({
					left: delta,
					behavior: useInstant ? 'instant' : 'smooth',
				});

				if (useInstant) {
					cancelAnimationFrame(instantSettleRafId);
					instantSettleRafId = requestAnimationFrame(() => {
						if (pendingTargetSlide) {
							handleSettle();
						}
					});
				}
			}

			function navigateByDirection(direction) {
				if (isInDomOrderForMarkerTrip) {
					queuedDirection = direction;
					return;
				}

				const baseSlide = pendingTargetSlide ?? getNearestSlide();
				let visual = getVisualSlides();
				let vIdx = visual.indexOf(baseSlide);
				let nextVIdx = vIdx + direction;

				if (nextVIdx < 0 || nextVIdx >= visual.length) {
					const baseDomIdx = slides.indexOf(baseSlide);
					repositionWithCompensation(() => {
						track.style.setProperty('--current', String(baseDomIdx));
					}, false);
					visual = getVisualSlides();
					vIdx = visual.indexOf(baseSlide);
					nextVIdx = vIdx + direction;
				}

				if (nextVIdx < 0 || nextVIdx >= visual.length) return;

				const targetSlide = visual[nextVIdx];
				pendingTargetSlide = targetSlide;
				pendingStartScrollLeft = track.scrollLeft;
				updateIndicators(slides.indexOf(targetSlide));
				scrollToSlide(targetSlide);
			}

			function handleSettle() {
				if (
					pendingTargetSlide &&
					pendingStartScrollLeft !== null &&
					Math.abs(track.scrollLeft - pendingStartScrollLeft) < 1
				) {
					const targetCenter = pendingTargetSlide.offsetLeft + pendingTargetSlide.offsetWidth / 2;
					const currentCenter = track.scrollLeft + track.clientWidth / 2;
					if (Math.abs(targetCenter - currentCenter) > 2) {
						return;
					}
				}

				pendingTargetSlide = null;
				pendingStartScrollLeft = null;

				const settledSlide = getNearestSlide();
				const settledIndex = slides.indexOf(settledSlide);
				updateIndicators(settledIndex);

				if (settledIndex !== lastSettledIndex) {
					lastSettledIndex = settledIndex;
					if (statusEl) {
						statusEl.textContent = `Slide ${settledIndex + 1} of ${slides.length}`;
					}
				}

				const currentProp = track.style.getPropertyValue('--current');
				if (isInDomOrderForMarkerTrip || currentProp !== String(settledIndex)) {
					repositionWithCompensation(() => {
						track.style.setProperty('--current', String(settledIndex));
					}, queuedDirection === 0);
				}

				isInDomOrderForMarkerTrip = false;

				if (queuedDirection !== 0) {
					const replayDir = queuedDirection;
					queuedDirection = 0;
					navigateByDirection(replayDir);
				}
			}

			// Initialize looping parking silently on load (no status announcement)
			repositionWithCompensation(() => {
				track.style.setProperty('--current', '0');
			}, false);
			updateIndicators(0);

			prevBtn.addEventListener('click', () => navigateByDirection(-1));
			nextBtn.addEventListener('click', () => navigateByDirection(1));

			dots.forEach((dot, targetIndex) => {
				dot.addEventListener('click', () => {
					const targetSlide = slides[targetIndex];
					const currentSlide = pendingTargetSlide ?? getNearestSlide();
					if (!targetSlide || targetSlide === currentSlide) return;

					repositionWithCompensation(() => {
						track.style.removeProperty('--current');
					}, false);

					isInDomOrderForMarkerTrip = true;
					pendingTargetSlide = targetSlide;
					pendingStartScrollLeft = track.scrollLeft;
					updateIndicators(targetIndex);
					scrollToSlide(targetSlide);
				});
			});

			track.addEventListener(
				'scroll',
				() => {
					if (!pendingTargetSlide && !scrollRafId) {
						scrollRafId = requestAnimationFrame(() => {
							scrollRafId = 0;
							const nearest = getNearestSlide();
							updateIndicators(slides.indexOf(nearest));
						});
					}

					if (!('onscrollend' in window)) {
						clearTimeout(scrollFallbackTimer);
						scrollFallbackTimer = window.setTimeout(handleSettle, 120);
					}
				},
				{ passive: true }
			);

			if ('onscrollend' in window) {
				track.addEventListener('scrollend', handleSettle);
			}
		}

		// Waitlist Form Front-End Confirmation
		const waitlistForm = document.getElementById('waitlist-form');
		const waitlistSubmit = document.getElementById('waitlist-submit');
		const waitlistConfirmation = document.getElementById('waitlist-confirmation');

		if (waitlistForm && waitlistConfirmation) {
			waitlistForm.addEventListener('submit', (event) => {
				event.preventDefault();
				if (!waitlistForm.checkValidity()) {
					waitlistForm.reportValidity();
					return;
				}
				if (waitlistSubmit) {
					waitlistSubmit.setAttribute('disabled', '');
				}
				waitlistForm.setAttribute('hidden', '');
				waitlistConfirmation.removeAttribute('hidden');
			});
		}
	})();
</script>
