---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hannah The Editor — Thoughtful Manuscript Editing">
	<!-- 1. Hero & Stats Banner (Background: brand-base) -->
	<section class="bg-brand-base py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 lg:gap-16">
				<!-- Left Column: Headline, Description, Two Buttons + Stats Row Below -->
				<div>
					<p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-ink/70">
						Literary &amp; Commercial Book Editing
					</p>

					<h1 class="mt-4 font-sans text-[48px] font-medium leading-[1.12] text-brand-ink">
						Thoughtful editing that brings your manuscript&rsquo;s truest voice to life.
					</h1>

					<p class="mt-6 max-w-xl text-base leading-relaxed text-brand-ink/80 sm:text-lg">
						From big-picture story architecture to line-by-line prose rhythm, partner with a dedicated book
						editor to shape a draft that literary agents, publishers, and readers cannot put down.
					</p>

					<!-- Two Buttons Side-by-Side (Primary brand-accent + Outline) -->
					<div class="mt-9 flex flex-wrap items-center gap-4">
						<a
							href="#free-chapter-review"
							class="inline-flex items-center justify-center rounded-full bg-brand-accent px-7 py-3.5 text-sm font-semibold text-brand-ink shadow-xs transition duration-200 hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
						>
							Book Free Chapter Review
						</a>

						<a
							href="#services"
							class="inline-flex items-center justify-center rounded-full border border-brand-ink/35 bg-transparent px-7 py-3.5 text-sm font-semibold text-brand-ink transition duration-200 hover:border-brand-accent hover:bg-brand-accent hover:text-brand-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
						>
							Explore Services
						</a>
					</div>

					<!-- Stats Bottom: 3-Column Row Immediately Below Hero Text -->
					<dl class="mt-12 grid grid-cols-3 gap-6 border-t border-brand-ink/15 pt-8">
						<div>
							<dt class="font-sans text-2xl font-semibold text-brand-ink sm:text-3xl">1,500</dt>
							<dd class="mt-1 text-xs leading-snug text-brand-ink/75">Words reviewed free</dd>
						</div>
						<div>
							<dt class="font-sans text-2xl font-semibold text-brand-ink sm:text-3xl">48 hrs</dt>
							<dd class="mt-1 text-xs leading-snug text-brand-ink/75">Sample turnaround</dd>
						</div>
						<div>
							<dt class="font-sans text-2xl font-semibold text-brand-ink sm:text-3xl">100%</dt>
							<dd class="mt-1 text-xs leading-snug text-brand-ink/75">Author IP protected</dd>
						</div>
					</dl>
				</div>

				<!-- Right Column: Large, Organic-Looking Image Placeholder -->
				<div class="relative mx-auto w-full max-w-lg md:max-w-none">
					<div
						aria-hidden="true"
						class="absolute -inset-3 rounded-[4rem_6rem_3.5rem_5.5rem] bg-brand-surface"
					></div>
					<div
						role="img"
						aria-label="Image Placeholder"
						class="relative flex aspect-[4/4.3] w-full items-center justify-center rounded-[3.5rem_6rem_3rem_5.5rem] bg-neutral-200 text-sm font-medium tracking-wide text-neutral-500 shadow-xs"
					>
						Image Placeholder
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. 3-Column Feature Grid (Canvas: brand-base, Cards: brand-surface) -->
	<section id="services" class="scroll-mt-16 border-t border-brand-ink/10 bg-brand-base py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="mx-auto max-w-2xl text-center">
				<h2 class="font-sans text-3xl font-medium text-brand-ink sm:text-4xl lg:text-5xl">
					Editorial Services for Every Stage
				</h2>
				<p class="mt-4 text-base leading-relaxed text-brand-ink/75">
					Tailored editorial partnerships designed around where your manuscript stands today and where you
					want to publish tomorrow.
				</p>
			</div>

			<div class="mt-16 grid grid-cols-1 items-stretch gap-8 md:grid-cols-3 lg:gap-10">
				<!-- Left Card (bg-brand-surface, no harsh white box) -->
				<article
					data-reveal
					style="--reveal-delay: 0ms"
					class="flex flex-col rounded-3xl border border-brand-ink/10 bg-brand-surface p-7 transition duration-300 hover:border-brand-ink/25 sm:p-8"
				>
					<div class="rounded-2xl bg-brand-base p-5">
						<div
							role="img"
							aria-label="Image Placeholder"
							class="flex aspect-[4/3] w-full items-center justify-center rounded-xl bg-neutral-200 text-sm font-medium text-neutral-500"
						>
							Image Placeholder
						</div>
					</div>

					<h3 class="mt-7 font-sans text-2xl font-medium text-brand-ink">
						Line &amp; Copy Editing
					</h3>
					<p class="mt-3 flex-1 text-sm leading-relaxed text-brand-ink/75">
						Sentence-by-sentence polish for prose musicality, dialogue naturalism, tonal consistency, and a
						bespoke manuscript style sheet.
					</p>

					<div class="mt-7">
						<a
							href="#free-chapter-review"
							class="inline-flex items-center justify-center rounded-full border border-brand-ink/30 px-5 py-2 text-xs font-semibold text-brand-ink transition hover:border-brand-accent hover:bg-brand-accent hover:text-brand-ink"
						>
							Request Sample
						</a>
					</div>
				</article>

				<!-- Center Card (Visually Prominent, bg-brand-surface + brand-accent highlight) -->
				<article
					data-reveal
					style="--reveal-delay: 90ms"
					class="relative flex flex-col rounded-3xl border-2 border-brand-accent bg-brand-surface p-7 shadow-md md:-translate-y-4 sm:p-9"
				>
					<span class="mx-auto mb-4 inline-block rounded-full bg-brand-accent px-3.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-brand-ink">
						Most Popular
					</span>

					<div class="rounded-2xl bg-brand-accent/12 p-5">
						<div
							role="img"
							aria-label="Image Placeholder"
							class="flex aspect-[4/3] w-full items-center justify-center rounded-xl bg-neutral-200 text-sm font-medium text-neutral-500"
						>
							Image Placeholder
						</div>
					</div>

					<h3 class="mt-7 font-sans text-2xl font-semibold text-brand-ink sm:text-[1.65rem]">
						Developmental Editing
					</h3>
					<p class="mt-3 flex-1 text-sm leading-relaxed text-brand-ink/80">
						Comprehensive structural evaluation of plot architecture, character arcs, stakes, and narrative
						pacing—paired with an in-depth editorial letter.
					</p>

					<div class="mt-7">
						<a
							href="#free-chapter-review"
							class="inline-flex items-center justify-center rounded-full bg-brand-accent px-6 py-2.5 text-xs font-semibold text-brand-ink shadow-xs transition hover:brightness-95"
						>
							Start With Free Review
						</a>
					</div>
				</article>

				<!-- Right Card (bg-brand-surface) -->
				<article
					data-reveal
					style="--reveal-delay: 180ms"
					class="flex flex-col rounded-3xl border border-brand-ink/10 bg-brand-surface p-7 transition duration-300 hover:border-brand-ink/25 sm:p-8"
				>
					<div class="rounded-2xl bg-brand-base p-5">
						<div
							role="img"
							aria-label="Image Placeholder"
							class="flex aspect-[4/3] w-full items-center justify-center rounded-xl bg-neutral-200 text-sm font-medium text-neutral-500"
						>
							Image Placeholder
						</div>
					</div>

					<h3 class="mt-7 font-sans text-2xl font-medium text-brand-ink">
						Query &amp; Opening Pages
					</h3>
					<p class="mt-3 flex-1 text-sm leading-relaxed text-brand-ink/75">
						Focused calibration of your query letter, synopsis, and first fifty pages to earn full
						manuscript requests from literary agents.
					</p>

					<div class="mt-7">
						<a
							href="#free-chapter-review"
							class="inline-flex items-center justify-center rounded-full border border-brand-ink/30 px-5 py-2 text-xs font-semibold text-brand-ink transition hover:border-brand-accent hover:bg-brand-accent hover:text-brand-ink"
						>
							Request Sample
						</a>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- 3. Wide Callout Banner (Alternating Panel: brand-surface) -->
	<section class="border-y border-brand-ink/10 bg-brand-surface py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="mx-auto max-w-3xl text-center">
				<h2 class="font-sans text-3xl font-medium leading-tight text-brand-ink sm:text-4xl lg:text-5xl">
					Decades of Craft Reflected in Every Margin Note
				</h2>
			</div>

			<dl class="mt-16 grid grid-cols-1 gap-10 text-center md:grid-cols-3 lg:gap-12">
				<div data-reveal style="--reveal-delay: 0ms" class="rounded-3xl border border-brand-ink/10 bg-brand-base px-8 py-10">
					<dt class="font-sans text-5xl font-medium text-brand-ink sm:text-6xl">25,000+</dt>
					<dd class="mt-3 text-sm font-medium text-brand-ink/75">
						Manuscript pages edited across literary fiction, commercial novels, and memoir
					</dd>
				</div>

				<div data-reveal style="--reveal-delay: 90ms" class="rounded-3xl border border-brand-ink/10 bg-brand-base px-8 py-10">
					<dt class="font-sans text-5xl font-medium text-brand-ink sm:text-6xl">17,000+</dt>
					<dd class="mt-3 text-sm font-medium text-brand-ink/75">
						Thoughtful margin notes and revision suggestions delivered to authors
					</dd>
				</div>

				<div data-reveal style="--reveal-delay: 180ms" class="rounded-3xl border border-brand-ink/10 bg-brand-base px-8 py-10">
					<dt class="font-sans text-5xl font-medium text-brand-ink sm:text-6xl">140+</dt>
					<dd class="mt-3 text-sm font-medium text-brand-ink/75">
						Full-length books guided from early draft to agent representation and publication
					</dd>
				</div>
			</dl>
		</div>
	</section>

	<!-- 4. Split Features with Center Image (Canvas: brand-base) -->
	<section id="features" class="scroll-mt-16 bg-brand-base py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="mx-auto max-w-2xl text-center">
				<h2 class="font-sans text-3xl font-medium text-brand-ink sm:text-4xl lg:text-5xl">
					What Sets Our Editorial Care Apart
				</h2>
			</div>

			<div class="mt-16 grid grid-cols-1 items-center gap-12 md:grid-cols-3 lg:gap-14">
				<!-- Left Column: Two Stacked Text Blocks -->
				<div data-reveal class="space-y-12 md:text-right">
					<div class="rounded-2xl bg-brand-surface/75 p-6">
						<h3 class="font-sans text-2xl font-medium text-brand-ink">
							Story Architecture First
						</h3>
						<p class="mt-3 text-sm leading-relaxed text-brand-ink/75">
							Before polishing individual sentences, we make sure your narrative engine, stakes, and
							emotional turning points earn every page.
						</p>
					</div>

					<div class="rounded-2xl bg-brand-surface/75 p-6">
						<h3 class="font-sans text-2xl font-medium text-brand-ink">
							Voice-Preserving Edits
						</h3>
						<p class="mt-3 text-sm leading-relaxed text-brand-ink/75">
							Great editing never sounds generic. Every line suggestion honors your natural cadence,
							humor, and stylistic fingerprint.
						</p>
					</div>
				</div>

				<!-- Center Column: Large, Tall Vertical Image Placeholder -->
				<div data-reveal style="--reveal-delay: 80ms" class="mx-auto w-full max-w-sm">
					<div
						role="img"
						aria-label="Image Placeholder"
						class="flex aspect-[3/4.3] min-h-[420px] w-full items-center justify-center rounded-3xl bg-neutral-200 text-sm font-medium tracking-wide text-neutral-500 shadow-xs"
					>
						Image Placeholder
					</div>
				</div>

				<!-- Right Column: Two Stacked Text Blocks Matching Left -->
				<div data-reveal style="--reveal-delay: 160ms" class="space-y-12">
					<div class="rounded-2xl bg-brand-surface/75 p-6">
						<h3 class="font-sans text-2xl font-medium text-brand-ink">
							Actionable Roadmaps
						</h3>
						<p class="mt-3 text-sm leading-relaxed text-brand-ink/75">
							Never feel overwhelmed by vague critique. Receive chapter-by-chapter revision priorities you
							can execute with clarity and momentum.
						</p>
					</div>

					<div class="rounded-2xl bg-brand-surface/75 p-6">
						<h3 class="font-sans text-2xl font-medium text-brand-ink">
							Publishing Market Insight
						</h3>
						<p class="mt-3 text-sm leading-relaxed text-brand-ink/75">
							Position your opening pages, query pitch, and manuscript pacing to meet current literary
							agency and acquisitions expectations.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 5. Alternating 'Zig-Zag' Highlights (Alternating Panel: brand-surface) -->
	<section id="highlights" class="scroll-mt-16 border-y border-brand-ink/10 bg-brand-surface py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="mx-auto max-w-2xl text-center">
				<h2 class="font-sans text-3xl font-medium text-brand-ink sm:text-4xl lg:text-5xl">
					How Your Manuscript Transformation Unfolds
				</h2>
			</div>

			<div class="mt-20 space-y-28 lg:space-y-36">
				<!-- Row 1: Image Left / Text Right -->
				<div data-reveal class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 lg:gap-20">
					<div class="relative pb-6 pl-6">
						<div
							aria-hidden="true"
							class="absolute bottom-0 left-0 h-[88%] w-[88%] rounded-3xl bg-brand-base"
						></div>
						<div
							role="img"
							aria-label="Image Placeholder"
							class="relative z-10 flex aspect-[4/3] w-full items-center justify-center rounded-2xl bg-neutral-200 text-sm font-medium text-neutral-500 shadow-xs"
						>
							Image Placeholder
						</div>
					</div>

					<div>
						<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-ink/70">Step 01</p>
						<h3 class="mt-3 font-sans text-3xl font-medium text-brand-ink sm:text-4xl">
							Begin With a Free Opening Chapter Diagnostic
						</h3>
						<p class="mt-4 text-base leading-relaxed text-brand-ink/80">
							Share the first 1,500 words of your draft. Within two business days, you&rsquo;ll receive
							tracked sample line edits and a candid assessment of your opening hook, tone, and narrative
							promise.
						</p>
						<div class="mt-8 flex flex-wrap items-center gap-4">
							<a
								href="#free-chapter-review"
								class="inline-flex items-center justify-center rounded-full bg-brand-accent px-6 py-3 text-xs font-semibold uppercase tracking-wider text-brand-ink transition hover:brightness-95"
							>
								Submit Chapter One
							</a>
							<a
								href="#services"
								class="inline-flex items-center justify-center rounded-full border border-brand-ink/35 px-6 py-3 text-xs font-semibold uppercase tracking-wider text-brand-ink transition hover:border-brand-accent hover:bg-brand-accent hover:text-brand-ink"
							>
								Compare Packages
							</a>
						</div>
					</div>
				</div>

				<!-- Row 2: Text Left / Image Right -->
				<div data-reveal class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 lg:gap-20">
					<div class="order-2 md:order-1">
						<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-ink/70">Step 02</p>
						<h3 class="mt-3 font-sans text-3xl font-medium text-brand-ink sm:text-4xl">
							Deep-Dive Margin Notes &amp; Editorial Letter
						</h3>
						<p class="mt-4 text-base leading-relaxed text-brand-ink/80">
							During your full edit, Hannah reads twice—first for holistic emotional immersion, then with
							a craft lens—delivering rich margin commentary alongside a clear revision blueprint.
						</p>
						<div class="mt-8 flex flex-wrap items-center gap-4">
							<a
								href="#free-chapter-review"
								class="inline-flex items-center justify-center rounded-full bg-brand-accent px-6 py-3 text-xs font-semibold uppercase tracking-wider text-brand-ink transition hover:brightness-95"
							>
								Book Your Slot
							</a>
							<a
								href="#reviews"
								class="inline-flex items-center justify-center rounded-full border border-brand-ink/35 px-6 py-3 text-xs font-semibold uppercase tracking-wider text-brand-ink transition hover:border-brand-accent hover:bg-brand-accent hover:text-brand-ink"
							>
								Read Author Stories
							</a>
						</div>
					</div>

					<div class="relative order-1 pr-6 pb-6 md:order-2">
						<div
							aria-hidden="true"
							class="absolute right-0 bottom-0 h-[88%] w-[88%] rounded-3xl bg-brand-accent/15"
						></div>
						<div
							role="img"
							aria-label="Image Placeholder"
							class="relative z-10 flex aspect-[4/3] w-full items-center justify-center rounded-2xl bg-neutral-200 text-sm font-medium text-neutral-500 shadow-xs"
						>
							Image Placeholder
						</div>
					</div>
				</div>

				<!-- Row 3: Image Left / Text Right -->
				<div data-reveal class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 lg:gap-20">
					<div class="relative pb-6 pl-6">
						<div
							aria-hidden="true"
							class="absolute bottom-0 left-0 h-[88%] w-[88%] rounded-3xl bg-brand-base"
						></div>
						<div
							role="img"
							aria-label="Image Placeholder"
							class="relative z-10 flex aspect-[4/3] w-full items-center justify-center rounded-2xl bg-neutral-200 text-sm font-medium text-neutral-500 shadow-xs"
						>
							Image Placeholder
						</div>
					</div>

					<div>
						<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-ink/70">Step 03</p>
						<h3 class="mt-3 font-sans text-3xl font-medium text-brand-ink sm:text-4xl">
							Follow-Up Support Until You Are Ready to Query
						</h3>
						<p class="mt-4 text-base leading-relaxed text-brand-ink/80">
							After receiving your notes, talk through questions in a 1-on-1 editorial call so you return
							to the page energized, focused, and completely confident in your next draft.
						</p>
						<div class="mt-8 flex flex-wrap items-center gap-4">
							<a
								href="#free-chapter-review"
								class="inline-flex items-center justify-center rounded-full bg-brand-accent px-6 py-3 text-xs font-semibold uppercase tracking-wider text-brand-ink transition hover:brightness-95"
							>
								Get Started Free
							</a>
							<a
								href="#features"
								class="inline-flex items-center justify-center rounded-full border border-brand-ink/35 px-6 py-3 text-xs font-semibold uppercase tracking-wider text-brand-ink transition hover:border-brand-accent hover:bg-brand-accent hover:text-brand-ink"
							>
								Our Philosophy
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 6. Reviews & Lead Capture (Canvas: brand-base, Form Container: brand-surface) -->
	<section id="reviews" class="scroll-mt-16 bg-brand-base py-24 lg:py-32">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<!-- Reviews Carousel with Left/Right Navigation Arrows -->
			<div data-reveal class="mx-auto max-w-4xl text-center">
				<h2 class="font-sans text-3xl font-medium text-brand-ink sm:text-4xl lg:text-5xl">
					Kind Words From Authors
				</h2>

				<div class="mt-12 flex items-center justify-between gap-4 sm:gap-8">
					<button
						id="review-prev"
						type="button"
						aria-label="Previous testimonial"
						class="flex h-12 w-12 shrink-0 cursor-pointer items-center justify-center rounded-full border border-brand-ink/20 bg-brand-surface text-brand-ink transition hover:border-brand-accent hover:bg-brand-accent hover:text-brand-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
					>
						<span aria-hidden="true" class="text-lg">&larr;</span>
					</button>

					<div class="min-h-[11rem] flex-1 px-2">
						<figure data-testimonial class="space-y-6">
							<blockquote class="font-sans text-2xl italic leading-relaxed text-brand-ink sm:text-3xl">
								&ldquo;Her free opening chapter review alone taught me more about scene tension than two
								years of workshops. Working with Hannah turned a sprawling third draft into a debut
								novel acquired at auction.&rdquo;
							</blockquote>
							<figcaption class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-ink/75">
								Julian Mercer &mdash; Literary Fiction Author
							</figcaption>
						</figure>

						<figure data-testimonial hidden class="space-y-6">
							<blockquote class="font-sans text-2xl italic leading-relaxed text-brand-ink sm:text-3xl">
								&ldquo;Rarely do you find an editor who combines razor-sharp structural instinct with
								such warmth and reverence for an author&rsquo;s voice. Every margin note made my book
								braver and clearer.&rdquo;
							</blockquote>
							<figcaption class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-ink/75">
								Nadia Okafor &mdash; Memoirist &amp; Essayist
							</figcaption>
						</figure>

						<figure data-testimonial hidden class="space-y-6">
							<blockquote class="font-sans text-2xl italic leading-relaxed text-brand-ink sm:text-3xl">
								&ldquo;Hannah pinpointed why my opening chapter stalled within three paragraphs. Two
								weeks after revising with her notes, I received four full manuscript requests from top
								agents.&rdquo;
							</blockquote>
							<figcaption class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-ink/75">
								Clara Vance &mdash; Historical Novel Debut
							</figcaption>
						</figure>
					</div>

					<button
						id="review-next"
						type="button"
						aria-label="Next testimonial"
						class="flex h-12 w-12 shrink-0 cursor-pointer items-center justify-center rounded-full border border-brand-ink/20 bg-brand-surface text-brand-ink transition hover:border-brand-accent hover:bg-brand-accent hover:text-brand-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
					>
						<span aria-hidden="true" class="text-lg">&rarr;</span>
					</button>
				</div>
			</div>

			<!-- Form Container: Wide Rounded-Corner Block (Background: brand-surface, zero harsh white) -->
			<div
				id="free-chapter-review"
				data-reveal
				class="mt-24 scroll-mt-24 rounded-3xl border border-brand-ink/12 bg-brand-surface px-6 py-12 sm:px-12 sm:py-16 lg:px-16"
			>
				<div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
