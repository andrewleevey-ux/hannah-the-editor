								class="inline-flex shrink-0 cursor-pointer items-center justify-center rounded-full bg-brand-accent px-8 py-4 text-sm font-semibold text-brand-ink shadow-xs transition duration-200 hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
							>
								Get Free Review
							</button>
						</form>

						<p
							id="lead-capture-confirmation"
							hidden
							role="status"
							aria-live="polite"
							class="rounded-2xl border border-brand-accent/30 bg-brand-base px-6 py-4 text-sm font-medium text-brand-ink"
						>
