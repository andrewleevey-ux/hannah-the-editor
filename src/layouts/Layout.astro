---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Hannah The Editor — Book Editing & Free Opening Chapter Review',
	description = 'Thoughtful developmental editing, line editing, and manuscript consulting for fiction and narrative nonfiction authors.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Typography: Host Grotesk -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
			rel="stylesheet"
		/>

		<script is:inline>
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.classList.add('js-ready');
			}
		</script>
	</head>
	<body class="flex min-h-screen flex-col bg-brand-base font-sans text-brand-ink selection:bg-brand-accent/20">
		<!-- Top Navigation Bar -->
		<header class="sticky top-0 z-30 w-full border-b border-brand-ink/10 bg-brand-base/95 backdrop-blur-sm">
			<div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
				<a href="/" aria-label="Hannah The Editor — Home" class="block shrink-0">
					<img
						src="/logo.svg"
						alt="Hannah The Editor"
						width="211"
						height="48"
						class="block h-10 w-auto sm:h-11"
					/>
				</a>

				<div class="flex flex-wrap items-center gap-6 sm:gap-8">
					<nav aria-label="Primary" class="hidden items-center gap-7 text-sm font-medium text-brand-ink/80 md:flex">
						<a href="#services" class="transition-colors hover:text-brand-ink">Services</a>
						<a href="#features" class="transition-colors hover:text-brand-ink">Approach</a>
						<a href="#highlights" class="transition-colors hover:text-brand-ink">Process</a>
						<a href="#reviews" class="transition-colors hover:text-brand-ink">Reviews</a>
					</nav>

					<a
						href="#free-chapter-review"
						class="inline-flex items-center justify-center rounded-full bg-brand-accent px-5 py-2.5 text-xs font-semibold tracking-wide text-brand-ink shadow-xs transition duration-200 hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-ink"
					>
						Free Chapter Review
					</a>
				</div>
			</div>
		</header>

		<!-- Main Page Content -->
		<main class="w-full flex-1">
			<slot />
		</main>

		<!-- 7. Clean 4-Column Footer (Alternating Mushroom Surface Panel) -->
		<footer class="w-full border-t border-brand-ink/15 bg-brand-surface text-brand-ink">
			<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
					<!-- Column 1: Logo & Studio Text -->
					<div>
						<a href="/" aria-label="Hannah The Editor — Home" class="inline-block">
							<img
								src="/logo.svg"
								alt="Hannah The Editor"
								width="194"
								height="44"
								class="block h-10 w-auto"
							/>
						</a>
						<p class="mt-4 max-w-xs text-sm leading-relaxed text-brand-ink/75">
							Warm, rigorous developmental and line editing for fiction and narrative nonfiction authors
							preparing for agents, publishers, and readers.
						</p>
					</div>

					<!-- Column 2: Navigation Links -->
					<div>
						<h3 class="font-sans text-lg font-semibold text-brand-ink">Editorial Services</h3>
						<ul class="mt-4 space-y-3 text-sm text-brand-ink/75">
							<li><a href="#services" class="transition-colors hover:text-brand-ink hover:underline">Developmental Editing</a></li>
							<li><a href="#services" class="transition-colors hover:text-brand-ink hover:underline">Line &amp; Copy Editing</a></li>
							<li><a href="#services" class="transition-colors hover:text-brand-ink hover:underline">Submission Intensive</a></li>
							<li><a href="#free-chapter-review" class="transition-colors hover:text-brand-ink hover:underline">Free Sample Edit</a></li>
						</ul>
					</div>

					<!-- Column 3: Navigation Links -->
					<div>
						<h3 class="font-sans text-lg font-semibold text-brand-ink">For Authors</h3>
						<ul class="mt-4 space-y-3 text-sm text-brand-ink/75">
							<li><a href="#features" class="transition-colors hover:text-brand-ink hover:underline">Our Approach</a></li>
							<li><a href="#highlights" class="transition-colors hover:text-brand-ink hover:underline">How Collaboration Works</a></li>
							<li><a href="#reviews" class="transition-colors hover:text-brand-ink hover:underline">Client Testimonials</a></li>
							<li><a href="#free-chapter-review" class="transition-colors hover:text-brand-ink hover:underline">Manuscript Prep Guide</a></li>
						</ul>
					</div>

					<!-- Column 4: Navigation Links -->
					<div>
						<h3 class="font-sans text-lg font-semibold text-brand-ink">Studio</h3>
						<ul class="mt-4 space-y-3 text-sm text-brand-ink/75">
							<li><a href="#highlights" class="transition-colors hover:text-brand-ink hover:underline">About Hannah</a></li>
							<li><a href="#free-chapter-review" class="transition-colors hover:text-brand-ink hover:underline">Confidentiality Promise</a></li>
							<li><a href="#free-chapter-review" class="transition-colors hover:text-brand-ink hover:underline">Book a Chapter Review</a></li>
							<li><a href="mailto:hello@hannahtheeditor.com" class="transition-colors hover:text-brand-ink hover:underline">hello@hannahtheeditor.com</a></li>
						</ul>
					</div>
				</div>

				<div class="mt-16 flex flex-col justify-between gap-4 border-t border-brand-ink/15 pt-8 text-xs text-brand-ink/65 sm:flex-row">
					<span>&copy; {new Date().getFullYear()} Hannah The Editor. All rights reserved.</span>
					<span>All submitted manuscripts remain strictly the intellectual property of the author.</span>
				</div>
			</div>
		</footer>

		<script is:inline>
			(() => {
				const items = document.querySelectorAll('[data-reveal]');
				if (!items.length || !('IntersectionObserver' in window)) {
					items.forEach((el) => el.classList.add('is-visible'));
					return;
				}

				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
				);

				items.forEach((el) => observer.observe(el));
			})();
		</script>
	</body>
</html>
