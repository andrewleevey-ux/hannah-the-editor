---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Hannah The Editor — Book Editing & Free Opening Chapter Review',
	description = 'Sophisticated developmental and line editing for fiction and narrative nonfiction authors. Book a complimentary 1,500-word opening chapter review.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Editorial Typography -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>

		<script is:inline>
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.classList.add('js-ready');
			}
		</script>
	</head>
	<body class="flex min-h-screen flex-col bg-pale-pink font-sans text-neutral-brown selection:bg-neutral-brown/15">
		<!-- Slim Editorial Navigation Bar -->
		<header class="sticky top-0 z-30 w-full border-b border-neutral-brown/15 bg-pale-pink/95 backdrop-blur-sm">
			<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 border-x border-neutral-brown/15 px-6 py-3 sm:px-10">
				<a href="/" aria-label="Hannah The Editor — Home" class="block shrink-0">
					<img
						src="/logo.svg"
						alt="Hannah The Editor"
						width="211"
						height="48"
						class="block h-10 w-auto sm:h-12"
					/>
				</a>

				<div class="flex flex-wrap items-center gap-5 sm:gap-6">
					<nav aria-label="Primary" class="flex items-center gap-5 text-xs uppercase tracking-[0.16em] text-neutral-brown/80 sm:gap-6">
						<a href="#services" class="transition-colors hover:text-neutral-brown">Services</a>
						<a href="#process" class="transition-colors hover:text-neutral-brown">Process</a>
						<a href="#praise" class="transition-colors hover:text-neutral-brown">Praise</a>
					</nav>

					<a
						href="#free-chapter-review"
						class="inline-flex items-center gap-2 rounded-xs border border-neutral-brown/25 bg-pastel-pink px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-[#212121] transition duration-200 hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-brown"
					>
						Free Chapter Review
					</a>
				</div>
			</div>
		</header>

		<!-- Full-Width Page Content -->
		<main class="w-full flex-1">
			<slot />
		</main>

		<!-- Editorial Colophon Footer -->
		<footer class="w-full border-t border-neutral-brown/15 bg-pale-pink">
			<div class="mx-auto max-w-6xl border-x border-neutral-brown/15 px-6 py-10 sm:px-10">
				<div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">
					<div>
						<p class="font-serif text-xl font-medium tracking-wide text-neutral-brown">
							Hannah The Editor
						</p>
						<p class="mt-1 text-xs text-neutral-brown/70">
							Developmental editing, line editing, and submission consulting for authors.
						</p>
					</div>

					<div class="flex flex-wrap items-center gap-6 text-xs uppercase tracking-[0.15em] text-neutral-brown/75">
						<a href="#services" class="transition-colors hover:text-neutral-brown">Services</a>
						<a href="#process" class="transition-colors hover:text-neutral-brown">Process</a>
						<a href="#praise" class="transition-colors hover:text-neutral-brown">Praise</a>
						<a href="#free-chapter-review" class="transition-colors hover:text-neutral-brown">
							Free Review
						</a>
					</div>
				</div>

				<div class="mt-8 flex flex-col justify-between gap-2 border-t border-neutral-brown/15 pt-6 text-xs text-neutral-brown/65 sm:flex-row">
					<span>&copy; {new Date().getFullYear()} Hannah The Editor. All rights reserved.</span>
					<span>All submitted manuscripts are held under strict confidentiality.</span>
				</div>
			</div>
		</footer>

		<script is:inline>
			(() => {
				const items = document.querySelectorAll('[data-reveal]');
				if (!items.length || !('IntersectionObserver' in window)) {
					items.forEach((el) => el.classList.add('is-visible'));
					return;
				}

				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
				);

				items.forEach((el) => observer.observe(el));
			})();
		</script>
	</body>
</html>
